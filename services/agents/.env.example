# Copy to .env and fill in. NEVER commit .env. Seeds are private keys: an agent's address is derived from its seed,
# so keep them stable (changing a seed changes the agent's address and you must re-register it on Agentverse).
# Generate a seed: python -c "import secrets; print(secrets.token_hex(24))"

SCOUT_SEED=
WATCHER_SEED=
RESCUER_SEED=
REPORTER_SEED=
NIGHT_AUDITOR_SEED=
# One seed per simulated shop agent listed in demo_places.json ("seed_env" field)
PLACE_AGENT_1_SEED=
PLACE_AGENT_2_SEED=
PLACE_AGENT_3_SEED=

# Streetwise engine (FastAPI). Agents never compute scores; they call this.
ENGINE_URL=http://localhost:8000

# "mailbox" (default): agents connect through the Agentverse mailbox and publish their profile.
# "local": no mailbox, no network registration (used by test_local.py).
STREETWISE_MODE=mailbox

# Optional: lets scout use ASI:One (OpenAI-compatible, model "asi1") to extract origin/destination/time when the
# deterministic parser fails. Leave empty to run on the deterministic parser alone.
ASI1_API_KEY=

# Optional behaviour
SCOUT_CARDS=0                 # 1 = also attach an Interactive Card (carousel). Text reply is always sent.
SCOUT_FIXED_SESSION=          # e.g. "demo" to make scout plan in the PWA's session (cleared at the start of every request)
PLACE_ASK_TIMEOUT_S=10
WATCH_CHECK_EVERY_S=300       # watcher: how often to check in during a walk
WATCH_REPLY_DEADLINE_S=120    # watcher: how long to wait for a reply before triggering the rescuer
WATCHER_TICK_S=10
AUDIT_EVERY_S=3600
BUREAU_PORT=8100                # keep off 8000 (engine)
OUT_DIR=./out
