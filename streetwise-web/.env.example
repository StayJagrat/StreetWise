# Gateway WebSocket (FastAPI). Leave empty to use the dev relay at same-origin /ws.
VITE_GATEWAY_URL=
# Set to "off" when the real agents drive the walk (no local demo engine, real GPS).
VITE_ENGINE=

# Server credentials belong in ../.env.server.local, outside Vite's root.
# See the repository's .env.server.example. Leave that file absent for memory mode.
