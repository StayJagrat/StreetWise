# Copy to ignored .env.server.local at the repository root.
# This file is read by FastAPI. Never put server keys in VITE_ variables.
SUPABASE_URL=https://myihzchlereyzckkavbn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A modern server secret can be used instead:
# SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Google OAuth must first be configured in Supabase Authentication.
SUPABASE_ANON_KEY=
GOOGLE_AUTH_ENABLED=false
# Optional: persistent disk location for the SQLite journal.
# STREETWISE_DB_PATH=/data/rooms.sqlite3
# Optional imagery explanations. Images never change route scores.
# MAPILLARY_ACCESS_TOKEN=
